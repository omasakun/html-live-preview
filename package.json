{
    "name": "html-live-preview",
    "displayName": "HTML Live Preview",
    "description": "Preview HTML in your browser real time(Reflush browser page when you save HTML files.)",
    "version": "0.0.1",
    "publisher": "omasakun",
    "engines": {
        "vscode": "^1.21.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "workspaceContains:**/*.html",
        "onCommand:htmlLivePreview.command.startWatching",
        "onCommand:htmlLivePreview.command.stopWatching",
        "onCommand:htmlLivePreview.command.reload",
        "onLanguage:html"
    ],
    "main": "./out/extension",
    "contributes": {
        "commands": [
            {
                "command": "htmlLivePreview.command.startWatching",
                "title": "html-live-preview: Preview HTML in your Browser"
            },
            {
                "command": "htmlLivePreview.command.stopWatching",
                "title": "html-live-preview: Stop Preview server"
            },
            {
                "command": "htmlLivePreview.command.reload",
                "title": "html-live-preview: Force browsers to reload"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "htmlLivePreview",
            "properties": {
                "htmlLivePreview.port": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "default": 8080,
                    "description": "Port"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "postinstall": "node ./node_modules/vscode/bin/install",
        "test": "npm run compile && node ./node_modules/vscode/bin/test"
    },
    "devDependencies": {
        "@types/mocha": "^2.2.42",
        "@types/node": "^7.0.43",
        "@types/socket.io": "^1.4.32",
        "typescript": "^2.6.1",
        "vscode": "^1.1.6"
    },
    "dependencies": {
        "node-watch": "^0.5.8",
        "socket.io": "^2.0.4"
    }
}
